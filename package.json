{
  "name": "plataforma-membros",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de membros (Google Apps Script + Neon PostgreSQL) para Diretoria-DPF.",
  "scripts": {
    "lint": "eslint \"src/**/*.gs\" \"src/**/*.html\" \"tests/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.gs\" \"src/**/*.html\" \"tests/**/*.js\" --fix",
    "test": "jest --colors",
