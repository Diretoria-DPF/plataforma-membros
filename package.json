    "clasp:status": "clasp status",
    "clasp:push": "clasp push --dry-run"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "eslint": "^8.57.0",
    "eslint-plugin-html": "^8.1.2",
