{
  "name": "plataforma-membros-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend da Plataforma de Membros como Cloudflare Worker (API JSON). Substitui o Google Apps Script — mesma lógica de segurança, motor de execução diferente.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "tail": "wrangler tail",
    "validate:sql": "node scripts/validate-migrations.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jest": "^29.7.0",
    "wrangler": "^3.90.0"
  }
}
