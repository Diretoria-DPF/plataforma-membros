# Cabeçalhos HTTP do site (Cloudflare Workers static assets / Pages).
# Valem só para arquivos estáticos; o GitHub Pages ignora este arquivo.
#
# Por que NÃO há um CSP completo aqui: cada página e cada módulo já tem a sua
# própria CSP em <meta> (index.html, 404.html, modulos/*/index.html), com
# necessidades diferentes (Atlas: wasm e workers; laboratório: RDKit). Um CSP
# completo em cabeçalho seria SOMADO a elas e quebraria os módulos. O que o
# <meta> não consegue expressar é frame-ancestors — só ele vai no cabeçalho.
#
# Desvios deliberados das regras genéricas (X-Frame-Options: DENY, camera=()):
# os módulos rodam em iframes do próprio site (frame-ancestors 'self' basta
# para impedir que OUTROS sites embutam a plataforma) e o check-in por QR
# (learning.js / modulos/fiscal) usa a câmera dentro de um desses iframes.
#
# HSTS sobe por degraus de propósito: se algo estiver errado no HTTPS do domínio,
# o navegador esquece rápido. Escalonamento (cada passo só depois de uma semana
# sem incidente): 7 dias (604800, passado) -> 30 dias (2592000, atual) -> 1 ano (31536000)
# -> só então includeSubDomains (apenas depois de listar os subdomínios com HTTPS
# válido) e, por último, preload. Hoje: 30 dias, sem includeSubDomains
# e sem preload.
#
# Cross-Origin-Opener-Policy same-origin-allow-popups isola a janela do site de
# páginas que a abram, sem quebrar popups que o próprio site abre.
# NÃO há Cross-Origin-Resource-Policy aqui: fotos e og:image precisam ser lidas
# por outros sites (prévias de link, redes sociais).
# Guia para bots e agentes de IA (RFC 8288): da página inicial para o sitemap e
# para a descrição em texto da LAIFT. Só aponta para arquivos públicos.
/
  Link: </sitemap.xml>; rel="sitemap", </llms.txt>; rel="describedby"; type="text/plain"

# Fora dos buscadores: a homologação e as URLs *.workers.dev (que servem o mesmo
# site) não devem aparecer no Google nem competir com laift.com.br. O noindex
# vai em cabeçalho porque robots.txt não impede a indexação de uma URL.
https://staging.laift.com.br/*
  X-Robots-Tag: noindex, nofollow

https://:name.:subdomain.workers.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.:name.:subdomain.workers.dev/*
  X-Robots-Tag: noindex, nofollow

/*
  Strict-Transport-Security: max-age=2592000
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'self'

# Demonstração embutida no portfólio do autor (?embed=1): só a /demo e as páginas dos módulos
# (que ela abre em iframe) aceitam esse outro ancestral. Um módulo embutido direto, sem a /demo,
# não acha a plataforma e volta ao index.html, que segue só com 'self'.
/demo
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self' https://dpflabs.com https://www.dpflabs.com

/demo.html
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self' https://dpflabs.com https://www.dpflabs.com

/modulos/*
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self' https://dpflabs.com https://www.dpflabs.com

# Blog: os posts mudam pouco (cache de 1 h). O índice muda a cada post novo,
# por isso tem 5 min. stale-while-revalidate deixa servir a cópia antiga por
# até 1 dia enquanto a nova é buscada.
/blog/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/blog.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/blog/index.json
  ! Cache-Control
  Cache-Control: public, max-age=300

# Biblioteca LAIFT (/biblioteca, CONTRATO-B2 §2.1): mesmo esquema do blog. O índice
# (instantâneo da primeira pintura) muda a cada deploy, por isso tem 5 min. O catálogo de verdade
# chega ao vivo da API (biblioteca/catalogo.js; cache de 60 s no Worker).
/biblioteca/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/biblioteca.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/biblioteca/index.json
  ! Cache-Control
  Cache-Control: public, max-age=300

# MOB-09: cache longo e imutável SÓ onde a versão está no próprio caminho (a pasta traz o número da
# versão e o <script> confere o hash por SRI): trocar de versão = trocar de URL. Nada do shell
# (HTML, sw.js, JS/CSS próprios) entra aqui: esses nomes não têm hash e continuam revalidando a cada
# visita (nomes com hash do shell ficaram de fora; ver docs/DESEMPENHO_MOBILE.md).
/modulos/laboratorio/vendor/smiles-drawer-2.1.7/*
  Cache-Control: public, max-age=31536000, immutable

/modulos/laboratorio/vendor/smiles-drawer-2.3.0/*
  Cache-Control: public, max-age=31536000, immutable
