  "za:vh-f-tricuspid-valve": {
    "ids": {
      "wikidata": "Q1344255",
      "fma": "7234",
      "uberon": "UBERON:0002134",
      "ta2": "A12.1.02.003",
      "mesh": "D014261"
    },
    "summary_pt": "A válvula tricúspide, ou valva tricúspide, ou valva atrioventricular direita, encontra-se no lado dorsal direito do coração dos mamíferos, entre o átrio direito(pt-BR) ou aurícula direita(pt-PT?) e o ventrículo direito. A função da válvula é impedir o refluxo do sangue do ventrículo direito para o átrio direito.",
    "sources": [
      {
        "field": "summary_pt",
        "type": "wikipedia",
