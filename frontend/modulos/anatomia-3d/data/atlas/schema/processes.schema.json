{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laift.local/atlas/schema/processes.schema.json",
  "title": "Processos fisiológicos do Atlas Anatômico",
  "description": "data/atlas/processes.json. Cada processo é uma sequência ordenada de passos; cada passo tem uma ou mais âncoras sobre estruturas reais (sid), com t opcional (0–1), usadas pela animação do modo Fisiologia & Vias.",
  "type": "array",
  "items": { "$ref": "#/$defs/process" },
  "$defs": {
    "sid": {
      "type": "string",
      "pattern": "^(fma:[0-9]+|za:[a-z0-9]+(-[a-z0-9]+)*)$"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sid"],
      "properties": {
        "sid": { "$ref": "#/$defs/sid" },
        "t": { "type": "number", "minimum": 0, "maximum": 1 },
        "label_pt": { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "description_pt", "anchors"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "description_pt": { "type": "string", "minLength": 1 },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/anchor" },
          "minItems": 1
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "system", "name_pt", "description_pt", "steps"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "system": { "type": "string" },
        "name_pt": { "type": "string", "minLength": 1 },
        "description_pt": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" },
          "minItems": 1
        }
      }
    }
  }
}
