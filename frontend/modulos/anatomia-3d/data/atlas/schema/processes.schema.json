{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laift.local/atlas/schema/processes.schema.json",
  "title": "Processos fisiológicos do Atlas Anatômico",
  "description": "data/atlas/processes.json. Cada processo é uma sequência ordenada de passos; cada passo tem uma ou mais âncoras sobre estruturas reais (sid), com t opcional (0–1), usadas pela animação do modo Fisiologia & Vias.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/process"
  },
  "$defs": {
    "sid": {
      "type": "string",
      "pattern": "^(fma:[0-9]+|za:[a-z0-9]+(-[a-z0-9]+)*)$"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sid"
      ],
      "properties": {
        "sid": {
          "$ref": "#/$defs/sid"
        },
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "label_pt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "description_pt",
        "anchors"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "description_pt": {
          "type": "string",
          "minLength": 1
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          },
          "minItems": 1
        },
        "refs": {
          "type": "array",
          "description": "obraId(s) de fontes.json que sustentam o passo.",
          "items": {
            "type": "string"
          }
        },
        "clinica_pt": {
          "type": "string"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "system",
        "name_pt",
        "description_pt",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "system": {
          "type": "string"
        },
        "name_pt": {
          "type": "string",
          "minLength": 1
        },
        "description_pt": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "legacy-unverified",
                "editorial",
                "reviewed",
                "approved"
              ]
            },
            "published_by": {
              "type": "string"
            },
            "review_requested_at": {
              "type": "string"
            },
            "by": {
              "type": "string"
            },
            "date": {
              "type": "string"
            }
          }
        },
        "feedback": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tipo",
              "efetor",
              "alvo",
              "efeito"
            ],
            "properties": {
              "tipo": {
                "enum": [
                  "negativo",
                  "positivo"
                ]
              },
              "efetor": {
                "type": "string"
              },
              "alvo": {
                "type": "string"
              },
              "efeito": {
                "type": "string"
              }
            }
          }
        },
        "desviosClinicos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condicao",
              "mecanismo"
            ],
            "properties": {
              "condicao": {
                "type": "string"
              },
              "mecanismo": {
                "type": "string"
              },
              "cid": {
                "type": "string"
              }
            }
          }
        },
        "interageCom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "ref",
        "obraId"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "obraId": {
          "type": "string",
          "minLength": 1
        },
        "capitulo": {
          "type": "string"
        },
        "exception": {
          "type": "boolean"
        },
        "justificativa": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
