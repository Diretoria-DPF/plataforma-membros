{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laift.local/atlas/schema/scenario.schema.json",
  "title": "Cenário clínico do modo Farmacologia (data/atlas/scenarios/<id>.json)",
  "description": "PR 3.2, Bloco C.3. Linha do tempo de um quadro clínico (ex.: crise colinérgica por organofosforado): fases com início/fim em minutos, sinais com o receptor envolvido e a estrutura no 3D, e antídotos com o que cada um reverte. Fontes só de fontes.json (validate-curated).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nome", "descricao", "agente", "fases", "antidotos", "sources", "review"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "nome": { "type": "string", "minLength": 3 },
    "descricao": { "type": "string", "minLength": 50 },
    "agente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nome", "mecanismo"],
      "properties": {
        "nome": { "type": "string" },
        "exemplos": { "type": "array", "items": { "type": "string" } },
        "mecanismo": { "type": "string", "minLength": 30 },
        "vias": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "titulo", "inicioMin", "fimMin", "fisiopatologia", "sinais"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "titulo": { "type": "string" },
          "inicioMin": { "type": "number", "minimum": 0 },
          "fimMin": { "type": "number", "minimum": 0 },
          "fisiopatologia": { "type": "string", "minLength": 30 },
          "sinais": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nome", "receptor"],
              "properties": {
                "nome": { "type": "string" },
                "receptor": { "enum": ["muscarinico", "nicotinico-muscular", "nicotinico-ganglionar", "snc"] },
                "sid": { "type": "string", "pattern": "^za:[a-z0-9]+(-[a-z0-9]+)*$" },
                "descricao": { "type": "string" }
              }
            }
          },
          "conduta": { "type": "string" }
        }
      }
    },
    "antidotos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nome", "mecanismo", "reverte", "naoReverte"],
        "properties": {
          "id": { "type": "string" },
          "nome": { "type": "string" },
          "compoundId": { "type": "string" },
          "mecanismo": { "type": "string", "minLength": 30 },
          "reverte": { "type": "array", "items": { "enum": ["muscarinico", "nicotinico-muscular", "nicotinico-ganglionar", "snc"] } },
          "naoReverte": { "type": "array", "items": { "enum": ["muscarinico", "nicotinico-muscular", "nicotinico-ganglionar", "snc"] } },
          "janela": { "type": "string" },
          "alvoTerapeutico": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "ref", "obraId"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "obraId": { "type": "string", "minLength": 1 },
          "capitulo": { "type": "string" },
          "exception": { "type": "boolean" },
          "justificativa": { "type": "string", "minLength": 20 }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["status", "published_by", "review_requested_at"],
      "properties": {
        "status": { "enum": ["editorial", "reviewed", "approved"] },
        "published_by": { "type": "string" },
        "review_requested_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "by": { "type": "string" },
        "date": { "type": "string" }
      }
    }
  }
}
