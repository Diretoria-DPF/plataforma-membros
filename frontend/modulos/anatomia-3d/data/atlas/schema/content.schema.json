{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laift.local/atlas/schema/content.schema.json",
  "title": "Conteúdo por estrutura do Atlas Anatômico",
  "description": "Cada arquivo content/<sistema>.json é um mapa sid → registro de conteúdo, carregado sob demanda quando o usuário abre a ficha de uma estrutura.",
  "type": "object",
  "propertyNames": {
    "pattern": "^(fma:[0-9]+|za:[a-z0-9]+(-[a-z0-9]+)*)$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/contentRecord"
  },
  "$defs": {
    "sid": {
      "type": "string",
      "pattern": "^(fma:[0-9]+|za:[a-z0-9]+(-[a-z0-9]+)*)$"
    },
    "source": {
      "type": "object",
      "description": "Uma fonte citada para um campo de texto específico deste registro. `field` usa notação de caminho (ex.: \"summary_pt\", \"anatomy.vascularization\", \"histology.epithelium\", \"clinical\").",
      "additionalProperties": false,
      "required": [
        "field",
        "type",
        "ref",
        "license"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "atlas",
            "fipat",
            "hra-asctb",
            "other",
            "textbook",
            "wikidata",
            "wikipedia"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Referência legível (título, obra, ou id da base de origem)."
        },
        "rev": {
          "type": "string",
          "description": "Revisão/versão da fonte (ex.: revisão da página, edição do livro)."
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://.+)$"
        },
        "obraId": {
          "type": "string",
          "minLength": 1,
          "description": "Id de uma obra de data/atlas/fontes.json (obrigatório para textbook/fipat/atlas no curado)."
        },
        "capitulo": {
          "type": "string",
          "minLength": 1
        },
        "exception": {
          "type": "boolean",
          "description": "Fonte fora de fontes.json — exige justificativa e revisão manual."
        },
        "justificativa": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cl",
        "name_pt"
      ],
      "properties": {
        "cl": {
          "type": "string",
          "description": "Id da Cell Ontology (ex.: CL:0000746).",
          "pattern": "^CL:[0-9]+$"
        },
        "name_pt": {
          "type": "string",
          "minLength": 1
        },
        "biomarkers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "ids": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fma": {
          "type": "string"
        },
        "uberon": {
          "type": "string",
          "pattern": "^UBERON:[0-9]+$"
        },
        "ta2": {
          "type": "string"
        },
        "wikidata": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "mesh": {
          "type": "string"
        },
        "icd10": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "anatomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relations": {
          "type": "string"
        },
        "vascularization": {
          "type": "string"
        },
        "innervation": {
          "type": "string"
        },
        "lymph": {
          "type": "string"
        }
      }
    },
    "histology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epithelium": {
          "type": "string"
        },
        "tissues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "description": "Estado de revisão humana do texto. A interface mostra um selo por estado (js/ui/infocard.js getStatusLabel): editorial = \"Em revisão editorial\" (publicado, aguardando o conselho da LAIFT); legacy-unverified = \"Conteúdo antigo · sem revisão\"; auto-draft = \"Gerado automaticamente · não revisado\"; reviewed/approved = \"Revisado por <by> em <date>\". Só o conselho editorial humano muda para reviewed/approved.",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "auto-draft",
            "legacy-unverified",
            "editorial",
            "reviewed",
            "approved"
          ]
        },
        "by": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "published_by": {
          "description": "Quem publicou a ficha com status editorial (ex.: \"atlas-curador (LAIFT)\").",
          "type": "string",
          "minLength": 1
        },
        "review_requested_at": {
          "description": "Data (AAAA-MM-DD) em que a revisão do conselho foi pedida — base do SLA e do aviso de atraso de 30 dias.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "contentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ids",
        "summary_pt",
        "sources",
        "review"
      ],
      "properties": {
        "ids": {
          "$ref": "#/$defs/ids"
        },
        "summary_pt": {
          "type": "string",
          "minLength": 1
        },
        "anatomy": {
          "$ref": "#/$defs/anatomy"
        },
        "histology": {
          "$ref": "#/$defs/histology"
        },
        "clinical": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "mnemonic_pt": {
          "description": "Mnemônico consagrado e citável (opcional). Nunca inventado.",
          "type": "string",
          "minLength": 1
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    }
  }
}
